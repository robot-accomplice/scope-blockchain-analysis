#!/usr/bin/env bash
# Pre-push hook: run the fast CI gates, then coverage, before a push.
# Install with: ./scripts/install-hooks.sh
#
# A push that only deletes remote branches checks nothing.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# Commits must use the project identity (#43).
REQUIRED_EMAIL="robot@accomplice.ch"
ZERO="0000000000000000000000000000000000000000"

pushes_commits=false
while read -r _local_ref local_sha _remote_ref remote_sha; do
    [ "$local_sha" = "$ZERO" ] && continue
    pushes_commits=true
    if [ "$remote_sha" = "$ZERO" ]; then
        range="$local_sha --not --remotes"
    else
        range="$remote_sha..$local_sha"
    fi
    # shellcheck disable=SC2086 # range holds several arguments on purpose
    bad="$(git log --format='%h %ae %ce' $range | awk -v e="$REQUIRED_EMAIL" '$2 != e || $3 != e')"
    if [ -n "$bad" ]; then
        echo "❌ These commits do not use $REQUIRED_EMAIL (hash, author, committer):"
        echo "$bad"
        echo "   Set it with: git config --local user.email $REQUIRED_EMAIL"
        exit 1
    fi
done
$pushes_commits || exit 0

for tool in cargo-audit cargo-tarpaulin; do
    command -v "$tool" >/dev/null || { echo "❌ $tool not found. Install with: cargo install $tool"; exit 1; }
done

echo "Format..."
cargo fmt --all --check
echo "Clippy..."
cargo clippy --quiet --workspace --all-targets -- -D warnings
echo "Security audit (.cargo/audit.toml)..."
cargo audit --quiet
"$REPO_ROOT/scripts/check-coverage.sh"
